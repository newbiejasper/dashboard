# DDYL - 人人可用的数据可视化神器
# Backend Configuration

APP_NAME: str = "DDYL BI Platform"
APP_VERSION: str = "1.0.0"
DEBUG: bool = False

# Database
DATABASE_URL: str = "sqlite+aiosqlite:///./ddyl.db"
# For production: "mysql+aiomysql://user:pass@localhost:3306/ddyl"
# For clickhouse: "clickhouse://default:@localhost:9000/ddyl"

# Redis / Celery
REDIS_URL: str = "redis://localhost:6379/0"
CELERY_BROKER_URL: str = "redis://localhost:6379/1"

# Security
SECRET_KEY: str = "ddyl-secret-key-change-in-production-2024"
ALGORITHM: str = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES: int = 1440  # 24 hours

# File Upload
UPLOAD_DIR: str = "media/uploads"
MAX_FILE_SIZE: int = 100 * 1024 * 1024  # 100MB
ALLOWED_EXTENSIONS: list = [".csv", ".xlsx", ".xls", ".txt", ".json", ".xml"]

# Doris / OLAP Engine
DORIS_HOST: str = "localhost"
DORIS_PORT: int = 9030
DORIS_USER: str = "root"
DORIS_PASSWORD: str = ""
DORIS_DATABASE: str = "ddyl_cache"

# Template Directory
TEMPLATE_DIR: str = "media/templates"
CORS_ORIGINS: list = ["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
