# DDYL BI Platform - Environment Configuration
APP_NAME=Dashboard Platform
APP_VERSION=1.0.0
DEBUG=true

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./ddyl.db

# Security
SECRET_KEY=ddyl-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload
UPLOAD_DIR=media/uploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=[".csv",".xlsx",".xls",".txt",".json",".xml"]

# Templates
TEMPLATE_DIR=media/templates

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
